NODE_ENV=development

# User Service
USER_SERVICE_PORT=3000
USER_DATABASE_URL=postgresql://user:password@user-db:5432/userdb

# Order Service
ORDER_SERVICE_PORT=3001
ORDER_DATABASE_URL=postgresql://user:password@order-db:5432/orderdb
USER_SERVICE_URL=http://user-service:3000
USER_SERVICE_TIMEOUT_MS=3000

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Security
INTERNAL_SERVICE_TOKEN=dev-service-token-2024
ADMIN_API_KEY=dev-admin-key-2024

# Logging
LOG_LEVEL=info
