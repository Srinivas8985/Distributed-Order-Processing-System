{
  "info": {
    "name": "Phase 8: Transactional Outbox Pattern",
    "description": "Tests for Phase 8: Simulating RabbitMQ outage to prove the Outbox pattern guarantees event reliability without blocking order creation.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Create Test User",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    pm.environment.set(\"userId\", pm.response.json().id);",
              "    pm.environment.set(\"idempotencyKey\", require('uuid').v4());",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:3000/users",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3000",
          "path": [
            "users"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"Phase 6 User\",\n    \"email\": \"phase6-user@example.com\"\n}"
        }
      }
    },
    {
      "name": "02 Normal Order Creation (Idempotent)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3001/orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"items\": [\n        {\n            \"productName\": \"Mechanical Keyboard\",\n            \"quantity\": 1,\n            \"unitPrice\": 149.99\n        }\n    ]\n}"
        }
      }
    },
    {
      "name": "03 Repeat Identical Request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 (Replay)\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3001/orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"items\": [\n        {\n            \"productName\": \"Mechanical Keyboard\",\n            \"quantity\": 1,\n            \"unitPrice\": 149.99\n        }\n    ]\n}"
        }
      }
    },
    {
      "name": "04 Repeat Request with Different Body",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 409 Conflict\", function () {",
              "    pm.response.to.have.status(409);",
              "});",
              "pm.test(\"Error is IDEMPOTENCY_CONFLICT\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql(\"IDEMPOTENCY_CONFLICT\");",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{idempotencyKey}}"
          }
        ],
        "url": {
          "raw": "http://localhost:3001/orders",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "3001",
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n    \"userId\": \"{{userId}}\",\n    \"items\": [\n        {\n            \"productName\": \"Hacked Keyboard\",\n            \"quantity\": 999,\n            \"unitPrice\": 149.99\n        }\n    ]\n}"
        }
      }
    }
  ]
}
