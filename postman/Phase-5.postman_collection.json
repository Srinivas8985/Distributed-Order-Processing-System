{
  "info": {
    "name": "Distributed Order Processing - Phase 5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Resilience Tests",
      "item": [
        {
          "name": "01 Create Test User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"userId\", jsonData.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Phase Five User\",\n  \"email\": \"phase5-resilience@example.com\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/users",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3000",
              "path": [
                "users"
              ]
            }
          }
        },
        {
          "name": "02 Normal Order Creation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Order created successfully\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"prod_resilience_1\",\n      \"productName\": \"Resilience Token\",\n      \"quantity\": 1,\n      \"unitPrice\": 99.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:3001/orders",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3001",
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "03 Trigger Retries (Requires Stopping User Service)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Service Unavailable returned after retries\", function () {",
                  "    pm.response.to.have.status(503);",
                  "});",
                  "pm.test(\"Specific timeout error code returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.be.oneOf(['USER_SERVICE_TIMEOUT', 'USER_SERVICE_UNAVAILABLE']);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"prod_resilience_1\",\n      \"productName\": \"Resilience Token\",\n      \"quantity\": 1,\n      \"unitPrice\": 99.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:3001/orders",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3001",
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "04 Trigger Circuit Open Fast Fail",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Service Unavailable returned instantly\", function () {",
                  "    pm.response.to.have.status(503);",
                  "});",
                  "pm.test(\"Response time is less than 100ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(100);",
                  "});",
                  "pm.test(\"Circuit Breaker open error code returned\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.error).to.eql(\"CIRCUIT_BREAKER_OPEN\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"items\": [\n    {\n      \"productId\": \"prod_resilience_1\",\n      \"productName\": \"Resilience Token\",\n      \"quantity\": 1,\n      \"unitPrice\": 99.99\n    }\n  ]\n}"
            },
            "url": {
              "raw": "http://localhost:3001/orders",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "3001",
              "path": [
                "orders"
              ]
            }
          }
        }
      ]
    }
  ]
}
